#!/usr/bin/env python3
"""install -- put this checkout's components where herdr and Claude Code look.

usage: ./install [--dry-run]

Reads ~/.config/herdr/tooling.toml (seeded from config/tooling.example.toml on
the first run) and, for every component, makes the machine match it:

  on    symlink its scripts into ~/.local/bin, its plugin directory into
        ~/.local/share/herdr-plugins and `herdr plugin link` it, its Claude hook
        into ~/.claude/hooks and ~/.claude/settings.json
  off   remove those links -- only links that point into this checkout

Then renders ~/.config/herdr/config.toml from config.local.toml plus the key
blocks of the components that are on, checks it with `herdr config check`,
backs up the old file and reloads the server.

Everything is a symlink into the checkout, so `git pull` updates the tools in
place; re-run install only after editing tooling.toml or config.local.toml, or
when a pull adds a component. Safe to re-run.
"""

import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time

REPO = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(REPO, "lib"))

import tooling  # noqa: E402

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local", "bin")
PLUGINS = os.path.join(HOME, ".local", "share", "herdr-plugins")
HERDR_DIR = os.path.join(HOME, ".config", "herdr")
CONFIG = os.path.join(HERDR_DIR, "config.toml")
LOCAL = os.path.join(HERDR_DIR, "config.local.toml")
RULES = os.path.join(HERDR_DIR, "sort-rules.toml")
HOOKS = os.path.join(HOME, ".claude", "hooks")
SETTINGS = os.path.join(HOME, ".claude", "settings.json")
MARKER = "# Generated by herdr-tooling/install"
LINUX = platform.system() == "Linux"

DRY = "--dry-run" in sys.argv
STAMP = time.strftime("%Y%m%d-%H%M%S")


def say(text):
    print(("(dry run) " if DRY else "") + text)


def into_repo(path):
    return os.path.islink(path) and os.path.realpath(path).startswith(REPO + os.sep)


def link(src, dest):
    src = os.path.join(REPO, src)
    if into_repo(dest) and os.path.realpath(dest) == os.path.realpath(src):
        return
    if os.path.lexists(dest) and not into_repo(dest):
        say(f"skip {dest}: exists and is not ours -- move it aside to install")
        return
    say(f"link {dest} -> {src}")
    if not DRY:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if os.path.lexists(dest):
            os.remove(dest)
        os.symlink(src, dest)


def unlink(dest):
    if into_repo(dest):
        say(f"remove {dest}")
        if not DRY:
            os.remove(dest)


def herdr(*args, check=False):
    return subprocess.run(["herdr", *args], capture_output=True, text=True, check=check)


def linked_plugins():
    try:
        out = json.loads(herdr("plugin", "list", "--json").stdout)
    except ValueError:
        return set()
    return {p.get("plugin_id") or p.get("id") for p in out["result"]["plugins"]}


# --- tooling.toml -----------------------------------------------------------

def load_config():
    path = os.path.expanduser(tooling.PATH)
    if not os.path.exists(path):
        say(f"write {path} from config/tooling.example.toml")
        if not DRY:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            shutil.copy(os.path.join(REPO, "config", "tooling.example.toml"), path)
            sys.exit(f"Review {path} -- at least [dash] memory-dir -- then re-run install.")
        return {}
    return tooling.load(path)


def wanted(config):
    on = {name for name in tooling.COMPONENTS if tooling.enabled(name, config)}
    for name in sorted(on):
        spec = tooling.COMPONENTS[name]
        if spec.get("linux") and not LINUX:
            say(f"skip {name}: reads /proc, Linux only")
            on.discard(name)
    for name in sorted(on):
        missing = [need for need in tooling.COMPONENTS[name].get("requires", [])
                   if need not in on]
        if missing:
            say(f"skip {name}: needs {', '.join(missing)}")
            on.discard(name)
    return on


# --- components -------------------------------------------------------------

def components(on):
    plugins = linked_plugins()
    for name, spec in tooling.COMPONENTS.items():
        active = name in on
        for src, installed in spec.get("bin", []):
            dest = os.path.join(BIN, installed)
            link(src, dest) if active else unlink(dest)
        if spec.get("plugin"):
            plugin(spec["plugin"], active, plugins)
        if spec.get("hook"):
            hook(spec["hook"], active)
    if "sort" in on and not os.path.exists(RULES):
        say(f"write {RULES} from config/sort-rules.example.toml -- edit it for your projects")
        if not DRY:
            shutil.copy(os.path.join(REPO, "config", "sort-rules.example.toml"), RULES)


def plugin(name, active, linked):
    dest = os.path.join(PLUGINS, name)
    if active:
        link(os.path.join("plugins", name), dest)
        if name not in linked:
            say(f"herdr plugin link {dest}")
            if not DRY:
                res = herdr("plugin", "link", dest)
                if res.returncode:
                    print(f"  failed: {(res.stderr or res.stdout).strip()}")
    else:
        if name in linked:
            say(f"herdr plugin unlink {name}")
            if not DRY:
                herdr("plugin", "unlink", name)
        unlink(dest)


def hook(src, active):
    dest = os.path.join(HOOKS, os.path.basename(src))
    command = f"python3 '{dest}'"
    link(src, dest) if active else unlink(dest)
    try:
        with open(SETTINGS) as fh:
            settings = json.load(fh)
    except FileNotFoundError:
        settings = {}
    groups = settings.setdefault("hooks", {}).setdefault("SessionStart", [])
    ours = [g for g in groups
            if any(os.path.basename(src) in h.get("command", "") for h in g.get("hooks", []))]
    if active == bool(ours):
        return
    if active:
        say(f"register {os.path.basename(src)} as a SessionStart hook in {SETTINGS}")
        groups.append({"matcher": "^(startup|clear|compact)$",
                       "hooks": [{"type": "command", "command": command, "timeout": 5}]})
    else:
        say(f"unregister {os.path.basename(src)} from {SETTINGS}")
        groups[:] = [g for g in groups if g not in ours]
    if not DRY:
        if os.path.exists(SETTINGS):
            shutil.copy(SETTINGS, f"{SETTINGS}.bak-{STAMP}")
        with open(SETTINGS, "w") as fh:
            json.dump(settings, fh, indent=2)
            fh.write("\n")


# --- config.toml ------------------------------------------------------------

def local_source():
    """config.local.toml, or what it will be seeded from on the first run."""
    if os.path.exists(LOCAL):
        return LOCAL
    # A config.toml this script did not write is the machine's own settings so far.
    if os.path.exists(CONFIG):
        with open(CONFIG) as fh:
            if not fh.read().startswith(MARKER):
                return CONFIG
    return os.path.join(REPO, "config", "local.example.toml")


def seed_local():
    source = local_source()
    if source != LOCAL:
        say(f"write {LOCAL} from {source}")
        if not DRY:
            shutil.copy(source, LOCAL)


def blocks(text):
    """A fragment as (comment preamble, [[keys.command]] blocks)."""
    head, *rest = text.split("[[keys.command]]")
    return head, ["[[keys.command]]" + block for block in rest]


def remap(block, keys):
    for old, new in keys.items():
        if f'key = "{old}"' in block:
            return block.replace(f'key = "{old}"', f'key = "{new}"') if new else None
    return block


def counted(block):
    """The block with its shell command wrapped in `herdr-keys run KEY --`."""
    key = re.search(r'^key = "([^"]+)"', block, re.M)
    if not key or not re.search(r'^type = "shell"', block, re.M):
        return block
    wrap = f"~/.local/bin/herdr-keys run {key.group(1)} -- "
    return re.sub(r'^command = "', lambda m: m.group(0) + wrap, block, count=1, flags=re.M)


def render(on, config):
    keys = config.get("keys", {})
    with open(local_source()) as fh:
        local = fh.read()
    parts = [f"{MARKER} from config.local.toml and the key\n"
             f"# blocks of the components on in tooling.toml. Edit those, then re-run\n"
             f"# {REPO}/install -- changes made here are overwritten.\n",
             local.rstrip() + "\n"]
    for name, spec in tooling.COMPONENTS.items():
        if name not in on or not spec.get("keys"):
            continue
        with open(os.path.join(REPO, "config", "keys", spec["keys"])) as fh:
            head, cmds = blocks(fh.read())
        cmds = [b for b in (remap(b, keys) for b in cmds) if b]
        if "keys" in on:
            cmds = [counted(b) for b in cmds]
        if cmds:
            parts.append(head.rstrip() + "\n\n" + "".join(cmds).rstrip() + "\n")
    return "\n".join(parts)


def write_config(text):
    current = None
    if os.path.exists(CONFIG):
        with open(CONFIG) as fh:
            current = fh.read()
    if current == text:
        return False
    with tempfile.NamedTemporaryFile("w", suffix=".toml", delete=False) as fh:
        fh.write(text)
        candidate = fh.name
    check = subprocess.run(["herdr", "config", "check"], capture_output=True, text=True,
                           env=dict(os.environ, HERDR_CONFIG_PATH=candidate))
    if check.returncode:
        sys.exit(f"rendered config fails `herdr config check` ({candidate}):\n"
                 f"{(check.stderr or check.stdout).strip()}")
    say(f"write {CONFIG}" + (f" (old one kept as config.toml.bak-{STAMP})" if current else ""))
    if DRY:
        os.remove(candidate)
    else:
        if current is not None:
            shutil.copy(CONFIG, f"{CONFIG}.bak-{STAMP}")
        shutil.move(candidate, CONFIG)
    return True


# --- checks -----------------------------------------------------------------

def checks(on):
    if "compose" in on and not shutil.which("nvim"):
        print("warning: compose needs nvim on PATH")
    if "viewer" in on and subprocess.run(
            ["python3", "-c", "import rich"], capture_output=True).returncode:
        print("warning: viewer needs rich for the python3 herdr runs: "
              "python3 -m pip install --user rich")
    if not os.environ.get("PATH", "").count(BIN):
        print(f"warning: {BIN} is not on PATH")


def main():
    if not shutil.which("herdr"):
        sys.exit("herdr is not on PATH")
    config = load_config()
    on = wanted(config)
    components(on)
    seed_local()
    changed = write_config(render(on, config))
    if changed and not DRY and herdr("server", "reload-config").returncode == 0:
        print("reloaded the herdr server's config")
    checks(on)
    print("on: " + ", ".join(n for n in tooling.COMPONENTS if n in on))


if __name__ == "__main__":
    main()
