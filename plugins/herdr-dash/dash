#!/usr/bin/env python3
"""herdr-dash -- one view of agents, memory, notes, prefixes and index health.

usage: dash [command] [options]

  tui              interactive pane (default; what both entrypoints run)
  once             render the same view once to stdout, then exit
  popup            open the popup pane over the socket and exit
  close-popup      dismiss it

options:
  --sections a,b   which sections, in order (default all)
  --collapsed a,b  start these folded; z unfolds
  --brief a,b      render these as a summary line only
  --interval SECS  refresh floor (default 5)
  --width N        once: render width (default: terminal width)
  --size WxH       popup: outer size in cells or percent (default 86%x80%)

Both entrypoints drive the same renderer. The popup is not reachable from the
CLI -- `herdr plugin pane open --placement` offers no popup -- so `dash popup`
calls plugin.pane.open over the socket, and the popup is dismissed with
popup.close because it carries no pane id and never appears in `pane list`.
"""

import argparse
import json
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dashlib import herdr as herdr_mod
from dashlib import model as model_mod
from dashlib import notes as notes_mod
from dashlib import reap
from dashlib import render
from dashlib import reports as reports_mod

PLUGIN_ID = "herdr-dash"
ENTRYPOINT = "popup"   # the manifest pane whose placement is popup
WAKE_EVENTS = ("pane.agent_status_changed", "pane.agent_detected",
               "pane.created", "pane.closed", "workspace.focused")


def _sections(text):
    names = [name.strip() for name in text.split(",") if name.strip()]
    unknown = [name for name in names if name not in render.SECTIONS]
    if unknown:
        raise SystemExit(f"dash: unknown section(s): {', '.join(unknown)}")
    return tuple(names)


def _size(text):
    width, _, height = text.partition("x")
    if not width or not height:
        raise SystemExit(f"dash: --size wants WxH, got {text!r}")
    return [int(part) if part.isdigit() else part for part in (width, height)]


# --- popup -----------------------------------------------------------------

def open_popup(size):
    width, height = size
    result = herdr_mod.Herdr(PLUGIN_ID).call("plugin.pane.open", {
        "plugin_id": PLUGIN_ID,
        "entrypoint": ENTRYPOINT,
        "placement": "popup",
        "width": width,
        "height": height,
        "focus": True,
    })
    # The response is a bare ok with no pane id, so there is nothing to record.
    print(json.dumps(result) if result else "ok")


def close_popup():
    herdr_mod.Herdr(PLUGIN_ID).call("popup.close", {})
    print("ok")


# --- refresh ---------------------------------------------------------------

class Refresher:
    """A collector thread with a timer floor, woken early by events.

    One subscription was measured never firing, so an event may only
    shorten the wait: every refresh recomputes from a fresh snapshot, and a
    missed event costs latency rather than a wrong number.
    """

    def __init__(self, sections, interval):
        self.sections = sections
        self.interval = interval
        self.model = {}
        self.stamp = 0.0
        self.error = None
        self.lock = threading.Lock()
        self.wake = threading.Event()
        self.stop = threading.Event()
        self.generation = 0

    def start(self):
        threading.Thread(target=self._collect_loop, daemon=True).start()
        threading.Thread(target=self._event_loop, daemon=True).start()

    def _collect_loop(self):
        while not self.stop.is_set():
            try:
                fresh, error = model_mod.collect(self.sections), None
            except Exception as err:
                fresh, error = None, f"{type(err).__name__}: {err}"
            with self.lock:
                if fresh is not None:
                    self.model = fresh
                    self.stamp = time.time()
                self.error = error
                self.generation += 1
            self.wake.clear()
            self.wake.wait(self.interval)

    def _event_loop(self):
        while not self.stop.is_set():
            try:
                for _ in herdr_mod.Herdr(PLUGIN_ID).events(WAKE_EVENTS):
                    self.wake.set()
                    if self.stop.is_set():
                        return
            except Exception:
                pass
            # The stream ends when the server restarts; back off, do not spin.
            self.stop.wait(10)

    def snapshot(self):
        with self.lock:
            return dict(self.model), self.stamp, self.error, self.generation

    def refresh_now(self):
        self.wake.set()


# --- curses ----------------------------------------------------------------

STYLES = {}


def _init_styles(curses):
    curses.use_default_colors()
    palette = {"head": (curses.COLOR_CYAN, curses.A_BOLD),
               "sub": (curses.COLOR_BLUE, 0),
               "ok": (curses.COLOR_GREEN, 0),
               "warn": (curses.COLOR_YELLOW, 0),
               "crit": (curses.COLOR_RED, curses.A_BOLD),
               "dim": (-1, curses.A_DIM),
               "normal": (-1, 0)}
    for index, (name, (color, attr)) in enumerate(palette.items(), 1):
        try:
            curses.init_pair(index, color, -1)
            STYLES[name] = curses.color_pair(index) | attr
        except curses.error:
            STYLES[name] = attr


class Tui:
    def __init__(self, stdscr, curses, refresher, order, collapsed=(), brief=()):
        self.stdscr = stdscr
        self.curses = curses
        self.refresher = refresher
        self.order = order
        self.brief = tuple(brief)
        self.collapsed = set(collapsed)
        self.top = 0
        self.cursor = 0
        # draw() clamps top to the last full screen, so when everything fits,
        # a digit jump cannot move top and z must target the jumped section.
        self.section = None
        self.lines = []
        self.generation = -1
        self.flash = ""
        self.flash_until = 0.0

    def say(self, message, seconds=4):
        self.flash = message
        self.flash_until = time.monotonic() + seconds

    def rebuild(self, model):
        height, width = self.stdscr.getmaxyx()
        self.lines = render.build(model, max(40, width - 1), self.order,
                                  self.collapsed, self.brief)
        self.targets = [index for index, line in enumerate(self.lines)
                        if line.target]
        if self.cursor >= len(self.targets):
            self.cursor = max(0, len(self.targets) - 1)

    def cursor_line(self):
        if not self.targets:
            return None
        return self.lines[self.targets[self.cursor]]

    def follow_cursor(self, body):
        if not self.targets:
            return
        index = self.targets[self.cursor]
        if index < self.top:
            self.top = index
        elif index >= self.top + body:
            self.top = index - body + 1

    def draw(self, stamp, error):
        height, width = self.stdscr.getmaxyx()
        body = max(1, height - 1)
        self.top = max(0, min(self.top, max(0, len(self.lines) - body)))
        self.stdscr.erase()
        focus = self.targets[self.cursor] if self.targets else -1
        for row in range(body):
            index = self.top + row
            if index >= len(self.lines):
                break
            line = self.lines[index]
            attr = STYLES.get(line.style, 0)
            if index == focus:
                attr |= self.curses.A_REVERSE
            try:
                self.stdscr.addnstr(row, 0, line.text.ljust(width - 1)
                                    if index == focus else line.text,
                                    width - 1, attr)
            except self.curses.error:
                pass
        self._status(height - 1, width, stamp, error)
        self.stdscr.refresh()

    def _status(self, row, width, stamp, error):
        if time.monotonic() < self.flash_until:
            text = f" {self.flash}"
            style = "warn"
        elif error:
            text = f" refresh failed: {error}"
            style = "crit"
        else:
            age = int(time.time() - stamp) if stamp else -1
            hints = [f"1-{len(self.order)} section", "z fold", "j/k move"]
            if "reports" in self.order:
                hints.append("enter answer report")
                hints.append("Y yes to clean offers")
            if "agents" in self.order:
                hints.append("enter focus pane")
            if "memory" in self.order:
                hints.append("x kill orphan")
            hints += ["n note", "e editor", "r refresh", "q quit"]
            text = (f" {time.strftime('%H:%M:%S', time.localtime(stamp))} "
                    f"({age}s ago)  │  " + " · ".join(hints))
            style = "dim"
        try:
            self.stdscr.addnstr(row, 0, text.ljust(width - 1), width - 1,
                                STYLES.get(style, 0) | self.curses.A_REVERSE)
        except self.curses.error:
            pass

    def prompt(self, label, row=None, style=None):
        height, width = self.stdscr.getmaxyx()
        row = height - 1 if row is None else row
        style = self.curses.A_REVERSE if style is None else style
        buf = ""
        self.curses.curs_set(1)
        # The main loop leaves the window non-blocking; get_wch() would raise
        # "no input" on the first idle tick instead of waiting for the typing.
        self.stdscr.timeout(-1)
        try:
            while True:
                text = f" {label}{buf}"
                try:
                    self.stdscr.addnstr(row, 0, text.ljust(width - 1),
                                        width - 1, style)
                    self.stdscr.move(row, min(width - 2, len(text)))
                except self.curses.error:
                    pass
                self.stdscr.refresh()
                try:
                    key = self.stdscr.get_wch()
                except self.curses.error:
                    continue
                if key in ("\n", "\r", self.curses.KEY_ENTER):
                    return buf
                if key == "\x1b":
                    return None
                if key in ("\x7f", "\b", self.curses.KEY_BACKSPACE):
                    buf = buf[:-1]
                elif isinstance(key, str) and key.isprintable():
                    buf += key
        finally:
            self.curses.curs_set(0)
            self.stdscr.timeout(250)

    def editor(self):
        command = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
        path = notes_mod.path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if not os.path.exists(path):
            notes_mod.write(notes_mod.read())
        self.curses.endwin()
        subprocess.call([*command.split(), path])
        self.stdscr.clear()
        self.curses.doupdate()
        self.refresher.refresh_now()

    def focus_pane(self, pane_id):
        try:
            herdr_mod.Herdr(PLUGIN_ID).call("pane.focus", {"pane_id": pane_id})
            return True
        except Exception as err:
            self.say(str(err))
            return False

    def handle(self, key, body):
        curses = self.curses
        if key in (ord("q"), ord("Q"), 27):
            return False
        if key not in (ord("z"),) and not ord("1") <= key <= ord("9"):
            self.section = None
        if key in (ord("j"), curses.KEY_DOWN):
            if self.targets:
                self.cursor = min(len(self.targets) - 1, self.cursor + 1)
                self.follow_cursor(body)
        elif key in (ord("k"), curses.KEY_UP):
            if self.targets:
                self.cursor = max(0, self.cursor - 1)
                self.follow_cursor(body)
        elif key in (curses.KEY_NPAGE, 4):
            self.top += body
        elif key in (curses.KEY_PPAGE, 21):
            self.top -= body
        elif key == ord("g"):
            self.top = 0
            self.cursor = 0
        elif key == ord("G"):
            self.cursor = max(0, len(self.targets) - 1)
            self.top = len(self.lines)
            self.follow_cursor(body)
        elif key == ord("r"):
            self.refresher.refresh_now()
            self.say("refreshing")
        elif ord("1") <= key <= ord("9"):
            position = key - ord("1")
            if position < len(self.order):
                name = self.order[position]
                self.section = name
                self.say(f"{render.TITLES[name]}: z folds/unfolds")
                for index, line in enumerate(self.lines):
                    if line.section == name:
                        self.top = index
                        break
        elif key == ord("z"):
            name = self.section or (
                self.lines[min(self.top, len(self.lines) - 1)].section
                if self.lines else None)
            if name:
                self.collapsed ^= {name}
                self.generation = -1
        elif key == ord("Y"):
            self.yes_to_clean()
        elif key in (ord("\n"), ord("\r"), curses.KEY_ENTER, 10, 13):
            line = self.cursor_line()
            if line and "report" == line.target[0]:
                return self.answer(line.target[1])
            if line and "agent" == line.target[0]:
                pane = line.target[1].get("pane")
                if pane and self.focus_pane(pane):
                    return False
        elif key in (ord("n"), ord("N")):
            attach = key == ord("N")
            target = notes_mod.GLOBAL
            if attach:
                line = self.cursor_line()
                if not line or "agent" != line.target[0]:
                    self.say("N attaches to an agent row; move the cursor there")
                    return True
                target = line.target[1].get("terminal_id")
                if not target:
                    self.say("that row has no terminal_id to key on")
                    return True
            text = self.prompt("note> ")
            if text:
                notes_mod.add(text, target)
                self.refresher.refresh_now()
                self.say("note saved")
        elif key == ord("d"):
            line = self.cursor_line()
            if line and "note" == line.target[0]:
                _, section, position = line.target
                notes_mod.remove(section, position)
                self.refresher.refresh_now()
                self.say("note deleted")
            else:
                self.say("d deletes a note; move the cursor to one")
        elif key == ord("e"):
            self.editor()
        elif key == ord("x"):
            self.kill_orphans()
        return True

    def _waiting(self):
        data = self.refresher.snapshot()[0].get("reports")
        return data["items"] if isinstance(data, dict) else []

    def _send(self, item, text):
        try:
            reports_mod.herdr_close.say(herdr_mod.Herdr(PLUGIN_ID).call, item["pane_id"],
                                        item["sid"], text)
            return True
        except Exception as err:
            self.say(f"could not reach {item['title']}: {err}")
            return False

    def yes_to_clean(self):
        clean = [i for i in self._waiting()
                 if reports_mod.herdr_close.clean_offer(i["report"])
                 and not (i["told_yes"] or i["stalled"] or i["blocked"])]
        if not clean:
            self.say("no clean close offers waiting")
            return
        answer = self.prompt(f"say yes to {len(clean)} clean offers? [y/N] ")
        if (answer or "").strip().lower() not in ("y", "yes"):
            self.say("nothing sent")
            return
        sent = sum(self._send(item, "yes") for item in clean)
        self.say(f"said yes to {sent}; each closes its own tab", seconds=6)
        self.refresher.refresh_now()

    def answer(self, first):
        """Walk the waiting reports from `first`: what is typed goes to that session, a bare
        enter moves on. Returns False when the dash should exit (a jump)."""
        seen, item = set(), first
        while item:
            seen.add(item["sid"])
            waiting = self._waiting()
            position = next((n for n, i in enumerate(waiting, 1)
                             if i["sid"] == item["sid"]), 0)
            text = self.card(item, position, len(waiting))
            command = (text or "").strip()
            if text is None or command in ("/quit", "/q"):
                break
            if command in ("/view", "/v"):
                self.page(item["reply"])
                continue
            if command in ("/jump", "/j"):
                if self.focus_pane(item["pane_id"]):
                    return False
                continue
            if command in ("/leave", "/l"):
                reports_mod.herdr_close.leave(item["sid"], item["replied_at"])
            elif command and self._send(item, command):
                self.say(f"sent to {item['title']}")
            item = next((i for i in self._waiting() if i["sid"] not in seen), None)
        else:
            self.say("no more reports waiting")
        self.refresher.refresh_now()
        self.generation = -1
        return True

    def card(self, item, position, total):
        """One report drawn at a fixed place, so the eye does not hunt for it."""
        import textwrap
        height, width = self.stdscr.getmaxyx()
        wrap = max(30, width - 6)
        rep = item["report"]
        lines = [(f"[{position or '?'} of {total}]  {item['title']}", "head")]
        if item["blocked"]:
            lines.append(("  waiting on a permission prompt: /jump answers it in the tab", "crit"))
        if item["stalled"]:
            lines.append((f"  {item['said'] or '/close'!r} never started: /jump to look", "warn"))
        if item["told_yes"] and "offer" == rep["kind"]:
            lines.append(("  told yes and still open; its reply says why", "warn"))
        if item["said"] and item["said"] != reports_mod.herdr_close.CLOSE_PROMPT:
            lines.append((render._clip(f"  you said: {item['said']}", width - 1), "dim"))
        if "reply" == rep["kind"]:
            body = [l for l in (item["reply"] or "(no reply)").strip().splitlines() if l.strip()]
            shown = []
            for line in body[-8:]:
                shown += textwrap.wrap(line, wrap) or [""]
            lines += [(f"  {l}", "normal") for l in shown[-10:]]
        else:
            head = rep["verdict"] or "(no verdict line)"
            if rep["next"] and "offer" == rep["kind"]:
                head += f" — next: {rep['next']}"
            lines += [(f"  {l}", "normal") for l in textwrap.wrap(head, wrap)[:3]]
            for result, text in rep["items"][:5]:
                label = "FAIL" if "fail" == result.lower() else result
                style = "crit" if "FAIL" == label else "dim"
                for n, l in enumerate(textwrap.wrap(text, wrap - 8)[:2]):
                    lines.append((f"  {label if 0 == n else '':<7} {l}", style))
            ask = rep["ask"] if "keep" == rep["kind"] else rep["side"]
            if ask:
                lines += [(f"  {l}", "warn") for l in textwrap.wrap(ask, wrap)[:3]]
        self.stdscr.erase()
        for row, (text, style) in enumerate(lines[:max(1, height - 4)]):
            try:
                self.stdscr.addnstr(row, 0, text, width - 1, STYLES.get(style, 0))
            except self.curses.error:
                pass
        row = min(len(lines), height - 4) + 1
        try:
            self.stdscr.addnstr(row + 2, 0, "  enter: next · /view · /jump · /leave · /quit",
                                width - 1, STYLES.get("dim", 0))
        except self.curses.error:
            pass
        return self.prompt("> ", row=row, style=0)

    def page(self, text):
        self.curses.endwin()
        try:
            subprocess.run(["less", "-R"], input=(text or "").encode(), check=False)
        except OSError as err:
            self.say(f"cannot run less: {err}")
        self.stdscr.clear()
        self.curses.doupdate()

    def kill_orphans(self):
        line = self.cursor_line()
        if not line or "orphan" != line.target[0]:
            self.say("x kills an orphaned pane; move the cursor to one")
            return
        pane_ids = line.target[1]
        label = pane_ids[0] if 1 == len(pane_ids) else f"{len(pane_ids)} panes"
        answer = self.prompt(f"kill every process of {label}? [y/N] ")
        if (answer or "").strip().lower() not in ("y", "yes"):
            self.say("kill cancelled")
            return
        self.say(f"killing {label}…", seconds=10)

        def work():
            try:
                result = reap.kill(pane_ids)
            except Exception as err:
                self.say(f"kill refused: {err}")
                return
            message = f"{label}: SIGTERM {result['killed']}"
            if result["forced"]:
                message += f", SIGKILL {result['forced']}"
            if result["skipped"]:
                message += f" · back in herdr, spared: {', '.join(result['skipped'])}"
            self.say(message, seconds=8)
            self.refresher.refresh_now()

        threading.Thread(target=work, daemon=True).start()

    def run(self):
        self.stdscr.timeout(250)
        while True:
            model, stamp, error, generation = self.refresher.snapshot()
            height, _ = self.stdscr.getmaxyx()
            body = max(1, height - 1)
            if generation != self.generation:
                self.generation = generation
                self.rebuild(model)
            self.draw(stamp, error)
            try:
                key = self.stdscr.getch()
            except KeyboardInterrupt:
                return
            if -1 == key:
                continue
            if self.curses.KEY_RESIZE == key:
                self.generation = -1
                continue
            if not self.handle(key, body):
                return


def tui(order, interval, collapsed=(), brief=()):
    import curses

    refresher = Refresher(order, interval)
    refresher.start()
    # Without this the pane is blank until the first collect returns.
    deadline = time.monotonic() + 5
    while not refresher.snapshot()[1] and time.monotonic() < deadline:
        time.sleep(0.05)

    def main(stdscr):
        curses.curs_set(0)
        _init_styles(curses)
        Tui(stdscr, curses, refresher, order, collapsed, brief).run()

    try:
        curses.wrapper(main)
    finally:
        refresher.stop.set()
        refresher.wake.set()


def once(order, width, brief=()):
    if not width:
        try:
            width = os.get_terminal_size().columns
        except OSError:
            width = 100
    print(render.plain(model_mod.collect(order), max(40, width - 1), order,
                       brief))


def main(argv):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("command", nargs="?", default="tui")
    parser.add_argument("--sections", type=_sections, default=render.SECTIONS)
    parser.add_argument("--collapsed", type=_sections, default=())
    parser.add_argument("--brief", type=_sections, default=())
    parser.add_argument("--interval", type=float, default=5.0)
    parser.add_argument("--width", type=int, default=0)
    parser.add_argument("--size", type=_size, default=["86%", "80%"])
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args(argv[1:])
    if args.help:
        print(__doc__.strip())
        return 0
    try:
        if "tui" == args.command:
            tui(tuple(args.sections), args.interval, set(args.collapsed),
                tuple(args.brief))
        elif "once" == args.command:
            once(tuple(args.sections), args.width, tuple(args.brief))
        elif "popup" == args.command:
            open_popup(args.size)
        elif "close-popup" == args.command:
            close_popup()
        else:
            sys.exit(f"dash: unknown command {args.command!r}")
    except herdr_mod.HerdrError as err:
        sys.exit(f"dash: {err}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
