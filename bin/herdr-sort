#!/usr/bin/env python3
"""herdr-sort — route Herdr tabs into workspaces by their agent session title.

usage: herdr-sort <command> [options]

  plan                 show what would move, change nothing
  once                 apply one sweep now
  daemon               watch events and sort continuously
  pin <target>         never touch this pane again (pane id or terminal id)
  unpin <target>       resume managing it
  status               daemon state, pins, last actions
  rules                parse and validate the rules file

  stale                KEEP / GLANCE / CLOSE for every open tab, with the reason
  close --as D <pane|#>...
                       close these with a disposition D: done filed merged dropped trivial;
                       done/filed/merged go to Linear first, and a Linear failure closes nothing
  close --safe         the CLOSE group after one confirmation (--yes skips it): trivial
                       ones as trivial, verified-done ones as done, the rest listed and
                       left open; with --as D, all of it as D
  cull                 walk every open tab: one sweep for trivial and verified-done tabs,
                       then one card and one key per tab (or group sharing a PR/ticket/file)
  popup                open `cull` as a herdr popup
  loops                closed sessions whose next step went nowhere: clear the ones a
                       later session resolved, then file / drop / mark trivial the rest
  review [--since 7d]  closes in the window grouped by disposition, with Linear links
  log [words]          closed sessions, newest first: summary, time, next step, disposition
  log --all [words]    every session on the box, not only closed ones
  reopen <id|#n|words> reopen a closed session in its old space
  ledger [--summarize] re-index transcripts; --summarize fills Haiku summaries

options:
  --settle SECS        title must hold still this long (default 30; 0 for once/plan)
  --max-moves N        cap moves per sweep (default 10)
  --rules PATH         rules file (default ~/.config/herdr/sort-rules.toml)
  --foreground         daemon: do not detach
  --verbose            log skip reasons too
  -n N                 log: rows to show (default 15)
  --limit N            ledger --summarize: cap the Haiku calls
  --as D               close: disposition (done filed merged dropped trivial)
  --ref ID             close: Linear issue to comment on (merged: the surviving tab's ticket)
  --note TEXT          close: reason; required for dropped
  --since AGE          review: window, e.g. 24h, 7d, 2w (default 7d)

cull / loops keys:
  d done (only when every check passes)  f file  m merge  x drop  t trivial  k keep
  s skip (loops)  j jump to tab  e edit draft in nvim  p project  w why  q quit
"""

import fcntl
import json
import datetime
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import termios
import textwrap
import threading
import time
import tty

STATE_DIR = os.path.expanduser("~/.local/state/herdr-sort")
STATE_PATH = os.path.join(STATE_DIR, "state.json")
LOCK_PATH = os.path.join(STATE_DIR, "daemon.lock")
LOG_PATH = os.path.join(STATE_DIR, "sort.log")
RULES_PATH = os.path.expanduser("~/.config/herdr/sort-rules.toml")
_REPO_PLUGIN = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                            "..", "plugins", "herdr-sort")
sys.path.insert(0, _REPO_PLUGIN if os.path.isdir(_REPO_PLUGIN)
                else os.path.expanduser("~/.local/share/herdr-plugins/herdr-sort"))
import herdr_ledger as ledger  # noqa: E402

EXPLICIT = re.compile(r"^\s*([A-Za-z][\w-]{0,15})\s*[:·]\s*(.+?)\s*$")
AUTO_LABEL = re.compile(r"^\d+$")
LABEL_MAX = 44


class Herdr:
    def __init__(self):
        self.path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser(
            "~/.config/herdr/herdr.sock"
        )

    def _connect(self, timeout):
        if not os.path.exists(self.path):
            raise SystemExit(f"herdr-sort: no herdr server socket at {self.path}")
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.settimeout(timeout)
        conn.connect(self.path)
        return conn

    def call(self, method, params=None):
        conn = self._connect(10)
        try:
            payload = {"id": "herdr-sort", "method": method, "params": params or {}}
            conn.sendall(json.dumps(payload).encode() + b"\n")
            buf = b""
            while b"\n" not in buf:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                buf += chunk
        finally:
            conn.close()
        try:
            response = json.loads(buf.split(b"\n", 1)[0])
        except ValueError:
            raise SystemExit(f"herdr-sort: unreadable response to {method}: {buf!r}")
        if "error" in response:
            err = response["error"]
            raise HerdrError(f"{method}: {err.get('code')}: {err.get('message')}")
        return response.get("result", {})

    def events(self, types):
        conn = self._connect(None)
        subs = [{"type": t} for t in types]
        payload = {"id": "herdr-sort", "method": "events.subscribe",
                   "params": {"subscriptions": subs}}
        conn.sendall(json.dumps(payload).encode() + b"\n")
        buf = b""
        while True:
            chunk = conn.recv(65536)
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if line.strip():
                    yield line


class HerdrError(Exception):
    pass


def strip_comment(raw):
    """A # inside a quoted pattern is not a comment -- \bPR ?#?\d is a real rule."""
    out, quoted, escaped = [], False, False
    for ch in raw:
        if escaped:
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == '"':
            quoted = not quoted
        elif ch == "#" and not quoted:
            break
        out.append(ch)
    return "".join(out).strip()


def parse_rules(path):
    """Strict subset of TOML: top-level scalars/arrays plus [[rule]] tables.

    Anything it cannot parse is an error with a line number — a rules file that
    silently half-loads would route tabs to the wrong workspace.
    """
    if not os.path.exists(path):
        raise SystemExit(f"herdr-sort: no rules file at {path} (run: herdr-sort rules --init)")
    top, rules, table = {}, [], None
    pending_key, pending_vals = None, None
    with open(path, encoding="utf-8") as handle:
        for lineno, raw in enumerate(handle, 1):
            line = strip_comment(raw) if not pending_key else raw.strip()
            if pending_key is not None:
                closed = line.endswith("]")
                for item in re.findall(r'"((?:[^"\\]|\\.)*)"', line):
                    pending_vals.append(item.encode().decode("unicode_escape"))
                if closed:
                    (table if table is not None else top)[pending_key] = pending_vals
                    pending_key, pending_vals = None, None
                continue
            if not line:
                continue
            if line == "[[rule]]":
                table = {}
                rules.append(table)
                continue
            if line.startswith("["):
                raise SystemExit(f"herdr-sort: {path}:{lineno}: only [[rule]] tables are supported")
            if "=" not in line:
                raise SystemExit(f"herdr-sort: {path}:{lineno}: cannot parse {line!r}")
            key, value = (part.strip() for part in line.split("=", 1))
            target = table if table is not None else top
            if value.startswith("["):
                vals = [m.encode().decode("unicode_escape")
                        for m in re.findall(r'"((?:[^"\\]|\\.)*)"', value)]
                if value.endswith("]"):
                    target[key] = vals
                else:
                    pending_key, pending_vals = key, vals
                continue
            m = re.match(r'^"((?:[^"\\]|\\.)*)"$', value)
            if not m:
                raise SystemExit(f"herdr-sort: {path}:{lineno}: value must be a string or array")
            target[key] = m.group(1).encode().decode("unicode_escape")
    compiled = []
    for i, rule in enumerate(rules, 1):
        for required in ("tag", "workspace"):
            if required not in rule:
                raise SystemExit(f"herdr-sort: {path}: rule {i} is missing {required!r}")
        try:
            compiled.append({
                "tag": rule["tag"],
                "workspace": rule["workspace"],
                "title": [re.compile(p, re.I) for p in rule.get("title", [])],
                "cwd": [re.compile(p, re.I) for p in rule.get("cwd", [])],
                "only_from": [w.strip().lower() for w in rule.get("only_from", [])],
            })
        except re.error as err:
            raise SystemExit(f"herdr-sort: {path}: rule {i} ({rule['tag']}): bad regex: {err}")
    return {"protect": top.get("protect", []), "rules": compiled}


def load_state():
    try:
        with open(STATE_PATH, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {"pins": {}, "expected": {}, "labels": {}}


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(state, handle, indent=1, sort_keys=True)
    os.replace(tmp, STATE_PATH)


def log(message):
    os.makedirs(STATE_DIR, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG_PATH, "a", encoding="utf-8") as handle:
        handle.write(f"{stamp} {message}\n")


GLYPHS = re.compile(r"^[\s\u2190-\u21ff\u2500-\u27bf\u2b00-\u2bff\u25a0-\u25ff\ufe0f\u2733]+")


AGENT_SUFFIX = re.compile(r"\s*\|\s*[\w.-]+$")


def normalize_title(text):
    """terminal_title_stripped keeps the working-spinner glyph, which anchors miss,
    and codex appends " | <repo>", which would eat a third of the tab label."""
    return AGENT_SUFFIX.sub("", GLYPHS.sub("", text or "")).strip()


def match_text(text):
    """Underscores are word characters, so \bfoo\b misses foo_bar."""
    return normalize_title(text).replace("_", " ")


def shorten(text, limit=LABEL_MAX):
    text = " ".join(text.split())
    return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def classify(pane, rules):
    """(target_workspace, tag, rest, source) or None. Explicit tags outrank rules."""
    label = pane.get("tab_label") or ""
    m = EXPLICIT.match(label)
    if m:
        tag, rest = m.group(1).lower(), m.group(2)
        for rule in rules["rules"]:
            if rule["tag"].lower() == tag:
                return rule["workspace"], rule["tag"], rest, "explicit"
    probe = match_text(pane.get("terminal_title_stripped"))
    display = normalize_title(pane.get("terminal_title_stripped"))
    cwd = pane.get("cwd") or ""
    here = (pane.get("workspace_label") or "").strip().lower()
    for rule in rules["rules"]:
        # A fallback rule only drains the inbox: a PR-numbered title carries no
        # project word, so without this it would pull the tab out of its project.
        if rule["only_from"] and here not in rule["only_from"]:
            continue
        if any(p.search(probe) for p in rule["title"]) or any(p.search(cwd) for p in rule["cwd"]):
            return rule["workspace"], rule["tag"], display, "title"
    return None


def snapshot_view(herdr):
    snap = herdr.call("session.snapshot")["snapshot"]
    workspaces = {w["workspace_id"]: w for w in snap["workspaces"]}
    tabs = {t["tab_id"]: t for t in snap["tabs"]}
    panes_per_tab = {}
    panes_per_ws = {}
    for pane in snap["panes"]:
        panes_per_tab[pane["tab_id"]] = panes_per_tab.get(pane["tab_id"], 0) + 1
        panes_per_ws[pane["workspace_id"]] = panes_per_ws.get(pane["workspace_id"], 0) + 1
    view = []
    for pane in snap["panes"]:
        tab = tabs.get(pane["tab_id"], {})
        ws = workspaces.get(pane["workspace_id"], {})
        item = dict(pane)
        item["tab_label"] = tab.get("label", "")
        item["workspace_label"] = ws.get("label", "")
        item["tab_panes"] = panes_per_tab.get(pane["tab_id"], 1)
        item["workspace_panes"] = panes_per_ws.get(pane["workspace_id"], 1)
        item["focused"] = pane["pane_id"] == snap.get("focused_pane_id")
        view.append(item)
    by_label = {}
    for ws in snap["workspaces"]:
        by_label.setdefault(ws["label"].strip().lower(), ws)
    return view, by_label


def adopt_manual_moves(view, state):
    """A pane that changed workspace without us is the user's placement: stop managing it."""
    changed = False
    for pane in view:
        term = pane["terminal_id"]
        expected = state["expected"].get(term)
        current = pane["workspace_label"]
        if expected is not None and expected != current and term not in state["pins"]:
            state["pins"][term] = "manual"
            log(f"pin {term} ({shorten(normalize_title(pane.get('terminal_title_stripped')), 30)}): "
                f"moved by hand to {current!r}, expected {expected!r}")
            changed = True
    return changed


def decide(view, rules, state, settle, titles_seen, now):
    decisions = []
    # Counted down as moves are decided: every pane in one sweep sees the same
    # snapshot, so a static count lets a sweep move a space's last panes together.
    remaining = {}
    for pane in view:
        remaining[pane["workspace_id"]] = pane["workspace_panes"]
    for pane in view:
        term = pane["terminal_id"]
        title = normalize_title(pane.get("terminal_title_stripped"))
        entry = titles_seen.get(term)
        if entry is None or entry[0] != title:
            titles_seen[term] = (title, now)
            entry = titles_seen[term]
        base = {
            "pane_id": pane["pane_id"], "terminal_id": term, "title": title,
            "tab_id": pane["tab_id"], "from": pane["workspace_label"],
            "to": None, "tag": None, "label": None, "action": "skip", "reason": "",
        }

        if not pane.get("agent"):
            base["reason"] = "no agent"
            decisions.append(base)
            continue
        if term in state["pins"]:
            base["reason"] = f"pinned ({state['pins'][term]})"
            decisions.append(base)
            continue

        match = classify(pane, rules)
        if not match:
            base["reason"] = "no rule matched"
            decisions.append(base)
            continue
        target_label, tag, rest, source = match
        base.update({"to": target_label, "tag": tag, "source": source})

        wanted_label = f"{tag} · {shorten(rest)}"
        current_label = pane["tab_label"]
        ours = state["labels"].get(term)
        may_rename = (AUTO_LABEL.match(current_label) or current_label == ours
                      or EXPLICIT.match(current_label))
        base["label"] = wanted_label if (may_rename and current_label != wanted_label) else None

        same_workspace = pane["workspace_label"].strip().lower() == target_label.strip().lower()
        if same_workspace:
            base["action"] = "rename" if base["label"] else "skip"
            base["reason"] = "already in place"
            decisions.append(base)
            continue
        if pane["focused"]:
            base["reason"] = "focused; deferred"
            decisions.append(base)
            continue
        if pane["tab_panes"] > 1:
            base["reason"] = f"tab has {pane['tab_panes']} panes; move it by hand"
            decisions.append(base)
            continue
        if source != "explicit" and settle and now - entry[1] < settle:
            base["reason"] = f"title unsettled ({int(now - entry[1])}s of {settle}s)"
            decisions.append(base)
            continue
        # Emptying a workspace closes it and renumbers the rest, so a protected
        # workspace always keeps its last pane.
        protected = pane["workspace_label"].strip().lower() in {
            p.strip().lower() for p in rules["protect"]}
        if protected and remaining[pane["workspace_id"]] <= 1:
            base["reason"] = f"last pane in protected {pane['workspace_label']!r}"
            decisions.append(base)
            continue

        remaining[pane["workspace_id"]] -= 1
        base["action"] = "move"
        base["reason"] = f"matched {tag} by {source}"
        decisions.append(base)
    return decisions


def destination(by_label, workspace_label, tab_label):
    """A missing workspace is created by the move itself.

    workspace.create would seed the new workspace with an empty root tab that
    nothing ever closes, so the first pane into a new workspace carries it.
    """
    existing = by_label.get(workspace_label.strip().lower())
    if existing:
        return {"type": "new_tab", "workspace_id": existing["workspace_id"],
                "label": tab_label}
    return {"type": "new_workspace", "label": workspace_label, "tab_label": tab_label}


def apply(herdr, decisions, by_label, state, max_moves):
    moves = 0
    for decision in decisions:
        if decision["action"] == "move":
            if moves >= max_moves:
                decision["reason"] = "move cap reached"
                decision["action"] = "skip"
                continue
            label = decision["label"] or shorten(decision["title"])
            dest = destination(by_label, decision["to"], label)
            try:
                result = herdr.call("pane.move", {
                    "pane_id": decision["pane_id"],
                    "destination": dest,
                    "focus": False,
                })
            except HerdrError as err:
                decision["action"] = "failed"
                decision["reason"] = str(err)
                log(f"FAILED move {decision['pane_id']} -> {decision['to']}: {err}")
                continue
            new_pane = result["move_result"]["pane"]
            decision["pane_id"] = new_pane["pane_id"]
            if dest["type"] == "new_workspace":
                by_label[decision["to"].strip().lower()] = {
                    "workspace_id": new_pane["workspace_id"]}
                log(f"created workspace {decision['to']!r} ({new_pane['workspace_id']})")
            state["expected"][decision["terminal_id"]] = decision["to"]
            state["labels"][decision["terminal_id"]] = label
            moves += 1
            log(f"move {decision['terminal_id']} {decision['from']!r} -> {decision['to']!r} "
                f"as {label!r} ({decision['reason']})")
        elif decision["action"] == "rename":
            try:
                herdr.call("tab.rename", {"tab_id": decision["tab_id"], "label": decision["label"]})
            except HerdrError as err:
                decision["action"] = "failed"
                decision["reason"] = str(err)
                continue
            state["labels"][decision["terminal_id"]] = decision["label"]
            state["expected"].setdefault(decision["terminal_id"], decision["from"])
            log(f"rename {decision['tab_id']} -> {decision['label']!r}")
    return moves


def sweep(herdr, rules, state, settle, titles_seen, dry_run, max_moves, verbose):
    view, by_label = snapshot_view(herdr)
    if adopt_manual_moves(view, state):
        save_state(state)
    decisions = decide(view, rules, state, settle, titles_seen, time.time())
    if not dry_run:
        apply(herdr, decisions, by_label, state, max_moves)
        for pane in view:
            term = pane["terminal_id"]
            if term in state["expected"] and not any(
                    d["terminal_id"] == term and d["action"] == "move" for d in decisions):
                state["expected"][term] = pane["workspace_label"]
        save_state(state)
    return [d for d in decisions if verbose or d["action"] != "skip" or d["reason"] not in
            ("no agent", "no rule matched", "already in place")], decisions


def print_table(decisions, dry_run):
    verb = {"move": "would move" if dry_run else "moved",
            "rename": "would rename" if dry_run else "renamed",
            "skip": "skip", "failed": "FAILED"}
    if not decisions:
        print("nothing to do")
        return
    width = max(len(d["title"][:38]) for d in decisions)
    for d in sorted(decisions, key=lambda d: (d["action"] != "move", d["from"])):
        title = (d["title"] or "(no title)")[:38]
        arrow = f"{d['from']} -> {d['to']}" if d["action"] == "move" else d["from"]
        print(f"  {verb[d['action']]:<11} {title:<{width}}  {arrow:<38} {d['reason']}")


def daemon(herdr, args):
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit("herdr-sort: a daemon is already running")
    lock.write(str(os.getpid()))
    lock.flush()

    wake = threading.Event()
    types = ["tab.created", "tab.renamed", "tab.closed", "pane.created", "pane.updated",
             "pane.moved", "pane.closed", "workspace.created", "workspace.renamed"]

    def reader():
        # The stream replays backlog on connect, so events are only a wake-up:
        # every decision is recomputed from a fresh snapshot.
        while True:
            try:
                for _ in herdr.events(types):
                    wake.set()
            except (OSError, SystemExit) as err:
                log(f"event stream dropped ({err}); reconnecting in 5s")
            time.sleep(5)

    threading.Thread(target=reader, daemon=True).start()
    log(f"daemon start pid={os.getpid()} settle={args['settle']}s socket={herdr.path}")
    state = load_state()
    titles_seen = {}
    rules_stamp = os.path.getmtime(args["rules"])
    rules = parse_rules(args["rules"])
    while True:
        wake.wait(timeout=10)
        wake.clear()
        time.sleep(1.5)
        try:
            stamp = os.path.getmtime(args["rules"])
            if stamp != rules_stamp:
                rules = parse_rules(args["rules"])
                rules_stamp = stamp
                log("rules reloaded")
            sweep(herdr, rules, state, args["settle"], titles_seen, False,
                  args["max_moves"], False)
        except HerdrError as err:
            log(f"sweep error: {err}")
        except SystemExit as err:
            log(f"fatal: {err}")
            raise


DEFAULT_RULES = '''# herdr-sort rules -- first match wins.
#
#   tag        prefix you can type into a tab label ("api: retry budget") to force a
#              destination; an explicit tag always outranks the title patterns
#   workspace  destination label, created on first match
#   title      case-insensitive regexes against the agent session title
#   cwd        case-insensitive regexes against the pane cwd
#
# Saved edits are picked up by a running daemon without a restart.

protect = ["All / Dump"]

[[rule]]
tag = "api"
workspace = "Public API"
title = ["\\\\bapi\\\\b", "\\\\bwebhooks?\\\\b"]

[[rule]]
tag = "tool"
workspace = "Tooling"
title = ["\\\\bherdr\\\\b", "\\\\bccnav\\\\b", "\\\\btmux\\\\b"]

[[rule]]
tag = "docs"
workspace = "Docs"
title = ["\\\\bdocs?\\\\b", "\\\\breadme\\\\b"]
'''


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    command = argv[1]
    args = {"settle": 30, "max_moves": 10, "rules": RULES_PATH,
            "foreground": False, "verbose": False}
    rest = []
    i = 2
    while i < len(argv):
        token = argv[i]
        if token in ("--settle", "--max-moves", "--rules", "-n", "--limit",
                     "--as", "--ref", "--note", "--since"):
            if i + 1 >= len(argv):
                raise SystemExit(f"herdr-sort: {token} needs a value")
            key = token.lstrip("-").replace("-", "_")
            text_valued = ("--rules", "--as", "--ref", "--note", "--since")
            args[key] = argv[i + 1] if token in text_valued else int(argv[i + 1])
            i += 2
            continue
        if token in ("--foreground", "--verbose", "--init", "--safe", "--yes", "--all",
                     "--summarize", "--json"):
            args[token.lstrip("-")] = True
            i += 1
            continue
        rest.append(token)
        i += 1

    if command == "rules":
        if args.get("init"):
            if os.path.exists(args["rules"]):
                raise SystemExit(f"herdr-sort: {args['rules']} already exists")
            with open(args["rules"], "w", encoding="utf-8") as handle:
                handle.write(DEFAULT_RULES)
            print(f"wrote {args['rules']}")
        rules = parse_rules(args["rules"])
        print(f"{args['rules']}: {len(rules['rules'])} rules, protect={rules['protect']}")
        for rule in rules["rules"]:
            print(f"  {rule['tag']:<6} -> {rule['workspace']:<22} "
                  f"{len(rule['title'])} title, {len(rule['cwd'])} cwd patterns")
        return 0

    if command in LEDGER_COMMANDS:
        return LEDGER_COMMANDS[command](args, rest)

    herdr = Herdr()
    state = load_state()

    if command in ("pin", "unpin"):
        if not rest:
            raise SystemExit(f"herdr-sort: {command} needs a pane id or terminal id")
        view, _ = snapshot_view(herdr)
        for target in rest:
            match = next((p for p in view if target in (p["pane_id"], p["terminal_id"])), None)
            if not match:
                raise SystemExit(f"herdr-sort: no pane {target!r}")
            term = match["terminal_id"]
            if command == "pin":
                state["pins"][term] = "manual"
            else:
                state["pins"].pop(term, None)
                state["expected"].pop(term, None)
            print(f"{command} {match['pane_id']} ({term}) "
                  f"{shorten(normalize_title(match.get('terminal_title_stripped')), 40)!r}")
        save_state(state)
        return 0

    if command == "status":
        running = "stopped"
        if os.path.exists(LOCK_PATH):
            probe = open(LOCK_PATH, "r+")
            try:
                fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(probe, fcntl.LOCK_UN)
            except OSError:
                running = f"running (pid {probe.read().strip()})"
        print(f"daemon:  {running}")
        print(f"socket:  {herdr.path}")
        print(f"rules:   {args['rules']}")
        print(f"pins:    {len(state['pins'])}")
        for term, why in state["pins"].items():
            print(f"           {term} ({why})")
        if os.path.exists(LOG_PATH):
            print("recent:")
            with open(LOG_PATH, encoding="utf-8") as handle:
                for line in handle.readlines()[-8:]:
                    print("  " + line.rstrip())
        return 0

    rules = parse_rules(args["rules"])

    if command in ("plan", "once"):
        dry_run = command == "plan"
        settle = args["settle"] if "--settle" in argv else 0
        shown, _ = sweep(herdr, rules, state, settle, {}, dry_run,
                         args["max_moves"], args["verbose"])
        print_table(shown, dry_run)
        return 0

    if command == "daemon":
        if not args["foreground"]:
            if os.fork() > 0:
                print(f"herdr-sort: daemon started (log: {LOG_PATH})")
                return 0
            os.setsid()
            devnull = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(devnull, fd)
        daemon(herdr, args)
        return 0

    raise SystemExit(f"herdr-sort: unknown command {command!r} (try --help)")


# --- ledger commands --------------------------------------------------------

VERDICT_ORDER = ("CLOSE", "GLANCE", "KEEP")


def _day(stamp):
    return datetime.datetime.fromtimestamp(stamp).strftime("%m-%d") if stamp else "  ?  "


def _stats(rec):
    return (f"{_day(rec.get('start'))}\u2192{_day(rec.get('last'))} \u00b7 "
            f"{ledger.human(rec.get('engaged_s'))} engaged \u00b7 "
            f"{ledger.human(rec.get('agent_s'))} agent \u00b7 {rec.get('prompts', 0)} prompts")


def _numbered_stale(rows):
    order = {v: i for i, v in enumerate(VERDICT_ORDER)}
    rows = sorted(rows, key=lambda r: (order[r["verdict"]], -(
        (r.get("rec") or {}).get("last") and time.time() - r["rec"]["last"] or 0)))
    for n, row in enumerate(rows, 1):
        row["n"] = n
    return rows


def cmd_stale(args, rest):
    rows, _ = ledger.assess()
    rows = _numbered_stale(rows)
    if args.get("json"):
        print(json.dumps([{k: v for k, v in r.items() if k != "rec"} for r in rows], indent=1))
        return 0
    counts = {v: sum(r["verdict"] == v for r in rows) for v in VERDICT_ORDER}
    print(" \u00b7 ".join(f"{counts[v]} {v}" for v in VERDICT_ORDER)
          + "   (close --safe closes the CLOSE group; each is logged and reopenable)")
    current = None
    for row in rows:
        if row["verdict"] != current:
            current = row["verdict"]
            print(f"\n{current}")
        rec = row.get("rec") or {}
        title = shorten(row["title"] or rec.get("title") or "(shell)", 46)
        print(f" {row['n']:>3} {shorten(row['workspace'], 19):<19} {title:<46} {row['reason']}")
        if rec.get("next_step") and row["verdict"] != "KEEP":
            print(f"     {'':<19} {shorten(rec['next_step'], 90)}")
    return 0


def _confirm(prompt):
    try:
        return input(prompt).strip().lower() in ("y", "yes")
    except EOFError:
        return False


def cmd_close(args, rest):
    disposition = args.get("as")
    if disposition is not None and disposition not in CLOSE_AS:
        raise SystemExit(f"herdr-sort: --as takes one of {', '.join(CLOSE_AS)}")
    if "dropped" == disposition and not (args.get("note") or "").strip():
        raise SystemExit('herdr-sort: --as dropped needs --note "why it was abandoned"')
    if "merged" == disposition and not args.get("ref"):
        raise SystemExit("herdr-sort: --as merged needs --ref <the surviving tab's ticket>")
    if not args.get("safe"):
        if not rest:
            raise SystemExit("herdr-sort: close needs --safe or pane ids / stale numbers")
        if not disposition:
            raise SystemExit(
                "herdr-sort: close needs a disposition: --as done|filed|merged|dropped|trivial\n"
                "  done/filed record the outcome or next step in Linear, merged comments on\n"
                "  --ref, trivial files nothing, dropped needs --note. `cull` walks them instead.")
    rows, index = ledger.assess()
    rows = _numbered_stale(rows)
    if args.get("safe"):
        chosen = [r for r in rows if "CLOSE" == r["verdict"]]
    else:
        chosen = []
        for target in rest:
            match = next((r for r in rows if target in (r["pane_id"], r["terminal_id"])
                          or target.lstrip("#") == str(r["n"])), None)
            if not match:
                raise SystemExit(f"herdr-sort: no open tab {target!r} (numbers come from `stale`)")
            chosen.append(match)
    if not chosen:
        print("nothing to close")
        return 0
    cards, linear, _ = _assess(chosen, index, [])
    cards = [c for c in cards if "open" == c["kind"]]
    plan, left = [], []
    for card in cards:
        if disposition:
            plan.append((card, disposition))
        elif card.get("trivial"):
            plan.append((card, "trivial"))
        elif card.get("done_ok"):
            plan.append((card, "done"))
        else:
            left.append(card)
    for card, chosen_as in plan:
        why = card.get("trivial") or (card.get("note") or {}).get("outcome") or ""
        print(f"  {chosen_as:<8} {_card_line(card)} {shorten(why, 60)}")
    if left:
        print("\nleft open, each needs a decision (`herdr-sort cull`, or close --as):")
        for card in left:
            print(f"  {card.get('suggested') or '?':<8} {_card_line(card)} {_undecided(card)}")
    if not plan:
        return 0
    if not args.get("yes") and not _confirm(f"close these {len(plan)} as shown? [y/N] "):
        print("nothing closed")
        return 1
    closer = _Closer(rows, index, linear)
    for card, chosen_as in plan:
        decision = _decision(chosen_as, note=args.get("note"), ref=args.get("ref"))
        if "failed" == closer.apply(card, decision):
            print("stopping; the rest stay open")
            break
    log(f"closed {closer.closed} tabs")
    print(f"closed {closer.closed}; `herdr-sort log` lists them, "
          "`herdr-sort reopen <n>` restores one")
    return 0


def cmd_log(args, rest):
    index = ledger.load_index()
    words = [w.lower() for w in rest]

    # Whole words, prefix-matched: "oa" must not hit "dashboard", but "expan" still
    # finds "expansion".
    patterns = [re.compile(r"(?<![a-z0-9])" + re.escape(w)) for w in words]

    def hit(*texts):
        blob = " ".join(t or "" for t in texts).lower().replace("_", " ")
        return all(p.search(blob) for p in patterns)

    if args.get("all"):
        index, _ = ledger.sync(index)
        rows = sorted(index.values(), key=lambda r: -(r.get("last") or 0))
        rows = [(None, r) for r in rows if r.get("prompts") and hit(
            r.get("title"), r.get("first_ask"), r.get("recap"), r.get("summary"))]
    else:
        events = list(reversed(ledger.closes()))
        rows = [(n, e) for n, e in enumerate(events, 1)]
        rows = [(n, e) for n, e in rows if hit(
            e.get("title"), e.get("workspace"),
            *[(index.get(e.get("key") or "") or {}).get(k) for k in ("recap", "summary", "first_ask")])]
    if not rows:
        print("no sessions match" if words else
              "nothing closed yet (try `herdr-sort log --all`)")
        return 0
    for n, item in rows[: args.get("n") or 15]:
        rec = item if n is None else index.get(item.get("key") or "") or {}
        title = (item.get("title") or rec.get("title") or rec.get("first_ask") or "(untitled)")
        where = item.get("workspace") if n is not None else rec.get("agent")
        head = f"#{n:<3}" if n is not None else "    "
        closed = f"  closed {_day(item['closed_at'])}" if n is not None else ""
        print(f"{head} {shorten(title, 58):<58} {shorten(where or '', 20)}{closed}")
        if n is not None and item.get("disposition"):
            print(f"     {_disposition_line(item)}")
        if rec:
            text, source = ledger.summary_of(rec)
            print(f"     {_stats(rec)}")
            print(f"     {shorten(text, 150)}" + ("" if "recap" == source else f"  [{source}]"))
            if rec.get("next_step") and rec["next_step"] not in text:
                print(f"     {shorten(rec['next_step'], 150)}")
            print(f"     {rec.get('resume')}")
        elif n is not None:
            print(f"     shell in {item.get('cwd')}; scrollback {item.get('scrollback') or 'empty'}")
    return 0


def cmd_reopen(args, rest):
    if not rest:
        raise SystemExit("herdr-sort: reopen needs an id prefix, #n from `log`, or title words")
    hits = ledger.find_closed(" ".join(rest))
    if not hits:
        raise SystemExit("herdr-sort: no closed session matches")
    if len(hits) > 1:
        print("several match; pick one by id:")
        for e in hits[:10]:
            print(f"  {(e.get('key') or ':').split(':', 1)[1][:8]}  {e.get('title')}")
        return 1
    pane, space = ledger.reopen(hits[0])
    print(f"reopened {hits[0].get('title')!r} in {space!r} ({pane})")
    return 0


def cmd_ledger(args, rest):
    index, parsed = ledger.sync()
    print(f"indexed {len(index)} sessions ({parsed} re-parsed)")
    if args.get("summarize"):
        pending = sum(ledger.needs_summary(r) for r in index.values())
        cap = args.get("limit") or pending
        print(f"summarizing {min(cap, pending)} of {pending} with {ledger.SUMMARY_MODEL}")
        done, failed = ledger.summarize(index, limit=args.get("limit"), progress=print)
        print(f"summarized {done}, failed {failed}")
    return 0


# --- dispositions: close --as, cull, loops, review ---------------------------

CLOSE_AS = ("done", "filed", "merged", "dropped", "trivial")
NOTES_PATH = os.path.join(ledger.STATE_DIR, "notes.json")
TICKET_RE = re.compile(r"^[A-Z][A-Z0-9]*-\d+(?:#\S+)?$")
CULL_KEYS = {"d": "done", "f": "file", "m": "merge", "x": "drop", "t": "trivial",
             "k": "keep", "j": "jump", "e": "edit", "p": "project", "w": "why", "q": "quit"}
LOOP_KEYS = {"f": "file", "x": "drop", "t": "trivial", "s": "skip", "e": "edit",
             "p": "project", "w": "why", "q": "quit"}


def _cull():
    # Imported on first use: the daemon runs this same file, and must keep
    # sorting when the installed plugin dir predates these modules.
    import herdr_cull
    import herdr_llm
    return herdr_cull, herdr_llm


def _load_notes():
    try:
        with open(NOTES_PATH, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def _save_notes(notes):
    os.makedirs(ledger.STATE_DIR, exist_ok=True)
    tmp = NOTES_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(notes, handle)
    os.replace(tmp, NOTES_PATH)


def _assess(rows, index, closes):
    cull, llm = _cull()
    linear, model = llm.ClaudeLinear(), llm.ClaudeLLM()
    notes = _load_notes()
    started = time.time()

    def progress(text):
        print(f"  {int(time.time() - started):>4}s  {text}", flush=True)

    print("reading sessions; every draft is written before the first card", flush=True)
    try:
        cards = cull.assess(rows, index, closes, model, started, notes=notes,
                            probe=cull.RealProbe(linear=linear), progress=progress)
    finally:
        _save_notes(notes)
    print(f"{len(cards)} cards in {int(time.time() - started)}s\n", flush=True)
    return cards, linear, model


def _decision(disposition, draft=None, note=None, ref=None):
    draft = draft or {}
    edited = draft.get("edited")
    return {"disposition": disposition, "note": note, "ref": ref,
            "project": draft.get("project"), "title": draft.get("title") if edited else None,
            "body": draft.get("body") if edited else None}


class _Closer:
    """Records a decision, then closes its tabs or resolves its closed sessions.

    ledger.close counts a space's tabs from each row's snapshot count, which is
    stale once an earlier card in the same walk closed tabs there; without the
    running count here, two separate closes can empty and delete a space. The
    same check runs before record, so Linear is never written for a tab that
    ledger.close would then refuse to close.
    """

    def __init__(self, rows, index, linear):
        self.index, self.linear = index, linear
        self.remaining = {r["workspace_id"]: r["workspace_panes"] for r in rows}
        self.closed, self.resolved, self.done_ids = 0, 0, set()

    def blocked(self, card):
        per_space = {}
        for member in card["members"]:
            row = member.get("row")
            if not row:
                continue
            if row.get("focused"):
                return f"{shorten(row['title'] or '(shell)', 40)!r} is the tab you're in"
            per_space[row["workspace_id"]] = per_space.get(row["workspace_id"], 0) + 1
            if self.remaining.get(row["workspace_id"], 0) - per_space[row["workspace_id"]] < 1:
                return f"it would empty {row['workspace']!r}, which deletes the space"
        return None

    def apply(self, card, decision):
        """'ok', 'blocked' (nothing written), or 'failed' (Linear refused; nothing closed)."""
        cull, llm = _cull()
        if "open" == card["kind"]:
            reason = self.blocked(card)
            if reason:
                print(f"  not closing: {reason}")
                return "blocked"
        try:
            fields = cull.record(card, decision, self.linear, time.time())
        except llm.LinearError as err:
            print(f"  Linear refused it; nothing recorded, nothing closed:\n    {err}")
            if cull.FALLBACK_PROJECT in str(err):
                print(f"    (create the {cull.FALLBACK_PROJECT!r} project in Linear, "
                      "or pick another with p)")
            return "failed"
        except (RuntimeError, ValueError, OSError) as err:
            print(f"  nothing recorded, nothing closed: {err}")
            return "failed"
        ref = next((f["ref"] for f in fields if f.get("ref")), None)
        if "loop" == card["kind"]:
            for item in fields:
                ledger.append_resolution(item["key"], item["closed_at"], item)
            self.resolved += len(fields)
            self.done_ids.add(card["id"])
            print(f"  {decision['disposition']}" + (f" -> {ref}" if ref else ""))
            return "ok"
        rows = [m["row"] for m in card["members"] if m.get("row")]
        for row in rows:
            row["workspace_panes"] = self.remaining[row["workspace_id"]]
        extra = {f["pane_id"]: f for f in fields if f.get("pane_id")}
        done = ledger.close(rows, self.index, extra=extra)
        for row in rows:
            if row.get("skipped"):
                print(f"  kept {shorten(row['title'] or '(shell)', 46)}: {row['skipped']}")
            else:
                self.remaining[row["workspace_id"]] -= 1
        self.closed += len(done)
        self.done_ids.add(card["id"])
        print(f"  {decision['disposition']}" + (f" -> {ref}" if ref else "")
              + f"; closed {len(done)} of {len(rows)}")
        return "ok"


def _card_line(card):
    return f"{shorten(card.get('workspace') or '', 19):<19} {shorten(card['title'], 46):<46}"


def _undecided(card):
    if card.get("note_error"):
        return f"no draft: {shorten(card['note_error'], 50)}"
    failing = [i for i in card.get("open_items") or [] if "fail" == i.get("result")]
    if failing:
        return f"{len(failing)} failing check(s): {shorten(failing[0].get('text') or '', 40)}"
    return shorten((card.get("note") or {}).get("next_step") or "", 60)


def _disposition_line(event):
    parts = [event["disposition"]]
    if event.get("ref"):
        parts.append(event["ref"])
    if event.get("ref_url"):
        parts.append(event["ref_url"])
    line = " ".join(parts)
    return f"{line} · {shorten(event['note'], 100)}" if event.get("note") else line


def _tickets(card):
    found = [i["id"] for i in (card.get("artifacts") or {}).get("issues") or [] if i.get("id")]
    for ident in (card.get("note") or {}).get("issues") or []:
        if ident not in found:
            found.append(ident)
    return found


def _next_step(card):
    note = card.get("note") or {}
    if note.get("next_step"):
        return note["next_step"]
    return next(((m.get("rec") or {}).get("next_step") for m in card["members"]
                 if (m.get("rec") or {}).get("next_step")), None)


def _wrap(label, text, indent=11):
    width = max(60, shutil.get_terminal_size((100, 40)).columns - 2)
    lead = f"  {label:<{indent - 2}}"
    return textwrap.fill(" ".join(str(text).split()), width, initial_indent=lead,
                         subsequent_indent=" " * indent)


def _print_card(card, n, total, draft):
    note = card.get("note") or {}
    print(f"\n[{n}/{total}] {card['title']}")
    where = card.get("workspace") or ""
    if "loop" == card["kind"]:
        closed = [(m.get("event") or {}).get("closed_at") for m in card["members"]]
        where += f" · closed {_day(max(c for c in closed if c))}" if any(closed) else ""
    print(f"  {where}")
    if len(card["members"]) > 1:
        for m in card["members"]:
            row, rec = m.get("row") or {}, m.get("rec") or {}
            print(f"    tab  {shorten(row.get('title') or rec.get('title') or '?', 50):<50} "
                  f"{shorten(row.get('workspace') or '', 18)}")
    if card.get("trivial"):
        print(_wrap("trivial", card["trivial"]))
    if card.get("note_error"):
        print(_wrap("no draft", card["note_error"]))
    if note.get("outcome"):
        print(_wrap("outcome", note["outcome"]))
    if _next_step(card):
        print(_wrap("next", _next_step(card)))
    for item in card.get("open_items") or []:
        result = {"fail": "FAIL"}.get(item.get("result"), item.get("result") or "?")
        detail = f" ({item['detail']})" if item.get("detail") else ""
        print(_wrap(f"  {result}", f"{item.get('kind')}: {item.get('text')}{detail}"))
    arts = card.get("artifacts") or {}
    bits = [f"PR {p['pr']} {p.get('state') or '?'}" for p in arts.get("prs") or []]
    bits += [f"{d['path']} {'present' if d.get('exists') else 'MISSING'}"
             for d in arts.get("docs") or []]
    bits += [f"{i['id']} {i.get('state') or '?'}" for i in arts.get("issues") or []]
    if bits:
        print(_wrap("landed", " · ".join(bits)))
    project = draft.get("project") or card.get("project") or _cull()[0].FALLBACK_PROJECT
    suggest = card.get("suggested") or "-"
    if card.get("done_ok"):
        suggest += " (verified)"
    print(_wrap("suggest", f"{suggest} · project {project}"))
    edited = draft.get("edited")
    title = draft["title"] if edited else note.get("draft_title")
    body = draft["body"] if edited else note.get("draft_body")
    if title:
        print(_wrap("draft", title))
        lines = (body or "").strip().splitlines()
        for line in lines[:12]:
            print(f"           {shorten(line, 110)}")
        if len(lines) > 12:
            print(f"           … {len(lines) - 12} more lines (e to read and edit)")


def _line(prompt):
    try:
        handle = open("/dev/tty", "r", encoding="utf-8", errors="replace")
    except OSError:
        try:
            return input(prompt).strip()
        except EOFError:
            return ""
    with handle:
        print(prompt, end="", flush=True)
        return handle.readline().strip()


def _yes(prompt):
    return _line(prompt).lower() in ("y", "yes")


def _key(prompt, allowed):
    while True:
        print(prompt, end="", flush=True)
        try:
            fd = os.open("/dev/tty", os.O_RDONLY)
        except OSError:
            fd = None
        if fd is None or not os.isatty(fd):
            if fd is not None:
                os.close(fd)
            try:
                ch = input().strip().lower()[:1]
            except EOFError:
                return "q"
        else:
            old = termios.tcgetattr(fd)
            try:
                tty.setraw(fd)
                ch = os.read(fd, 4).decode("utf-8", "replace")[:1]
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
                os.close(fd)
            print(ch if ch.isprintable() else "")
            if "\x03" == ch:
                raise KeyboardInterrupt
            ch = "q" if ch in ("\x04", "\x1b") else ch.lower()
        if ch in allowed:
            return ch
        print("  keys: " + "  ".join(f"{k} {v}" for k, v in allowed.items()))


def _edit_draft(card, draft):
    if draft.get("title") is None:
        seed = "done" if "done" == card.get("suggested") else "filed"
        draft.update(_cull()[0].draft(card, seed))
    fd, path = tempfile.mkstemp(prefix="herdr-cull-", suffix=".md")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(f"{draft['title']}\n\n{draft['body'].strip()}\n")
        try:
            with open("/dev/tty") as term:
                subprocess.call(["nvim", path], stdin=term)
        except OSError as err:
            print(f"  cannot run nvim: {err}")
            return
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    finally:
        os.unlink(path)
    if not lines or not lines[0].strip():
        print("  first line (the title) is empty; draft unchanged")
        return
    draft["title"], draft["body"] = lines[0].strip(), "\n".join(lines[1:]).strip() + "\n"
    draft["edited"] = True


def _pick_project(llm, draft):
    try:
        names = llm.projects()
    except RuntimeError as err:
        print(f"  cannot list projects: {err}")
        return
    fallback = _cull()[0].FALLBACK_PROJECT
    names = names if fallback in names else [*names, fallback]
    for n, name in enumerate(names, 1):
        print(f"  {n:>3}  {name}")
    answer = _line("project (number or name, enter keeps it): ")
    if not answer:
        return
    if answer.isdigit() and 1 <= int(answer) <= len(names):
        draft["project"] = names[int(answer) - 1]
        return
    match = next((name for name in names if name.lower() == answer.lower()), None)
    if match:
        draft["project"] = match
    else:
        print(f"  no open project named {answer!r}")


def _pick_merge_target(card, others):
    candidates = [c for c in others if c["id"] != card["id"]]
    for n, other in enumerate(candidates, 1):
        tickets = ", ".join(_tickets(other)) or "no ticket"
        print(f"  {n:>3}  {_card_line(other)} {tickets}")
    answer = _line("merge into (number, or a ticket id like GROWTH-123): ")
    if not answer:
        return None
    if answer.isdigit() and 1 <= int(answer) <= len(candidates):
        tickets = _tickets(candidates[int(answer) - 1])
        if not tickets:
            print("  that tab has no ticket yet; file it first, or type a ticket id")
            return None
        return tickets[0]
    if TICKET_RE.match(answer.upper()):
        return answer.upper()
    print(f"  {answer!r} is neither a number from the list nor a ticket id")
    return None


def _jump(card, popup):
    pane = next((m["row"]["pane_id"] for m in card["members"] if m.get("row")), None)
    if not pane:
        print("  no open tab for this card")
        return False
    try:
        ledger.call("pane.focus", {"pane_id": pane})
    except (RuntimeError, OSError) as err:
        print(f"  cannot focus {pane}: {err}")
        return False
    if not popup:
        print(f"  focused {pane}")
        return False
    # The popup stays over the focused pane, so jumping from it ends the walk;
    # notes are cached, so the next cull reaches the remaining cards quickly.
    ledger.call("popup.close", {})
    return True


def _why(card):
    sid = ((card.get("note") or {}).get("model_session")
           or (card.get("resolved_by") or {}).get("model_session"))
    if not sid:
        print("  no model run behind this card")
        return
    print(f"  cd {ledger.MODEL_CWD} && claude --resume {sid}")


def _walk(cards, closer, llm, keys, others=None, popup=False):
    """One card at a time; returns how many were left undecided."""
    for n, card in enumerate(cards, 1):
        draft = {}
        _print_card(card, n, len(cards), draft)
        while True:
            offered = {k: v for k, v in keys.items() if "d" != k or card.get("done_ok")}
            key = _key("  " + "  ".join(f"{k} {v}" for k, v in offered.items()) + " > ", offered)
            disposition, extra = None, {}
            if "q" == key:
                return len(cards) - n + 1
            if key in ("k", "s"):
                break
            if "j" == key:
                if _jump(card, popup):
                    return len(cards) - n + 1
                continue
            if "e" == key:
                _edit_draft(card, draft)
                _print_card(card, n, len(cards), draft)
                continue
            if "p" == key:
                _pick_project(llm, draft)
                print(_wrap("project", draft.get("project") or card.get("project")
                            or _cull()[0].FALLBACK_PROJECT))
                continue
            if "w" == key:
                _why(card)
                continue
            if "d" == key:
                disposition = "done"
            elif "f" == key:
                if not card.get("note") and not draft.get("edited"):
                    print("  no model draft; write one (title on the first line)")
                    _edit_draft(card, draft)
                    if not draft.get("edited"):
                        continue
                disposition = "filed"
            elif "t" == key:
                disposition = "trivial"
            elif "x" == key:
                reason = _line("  why drop it? (enter cancels) ")
                if not reason:
                    continue
                disposition, extra = "dropped", {"note": reason}
            elif "m" == key:
                ref = _pick_merge_target(card, [c for c in others or []
                                                if c["id"] not in closer.done_ids])
                if not ref:
                    continue
                disposition, extra = "merged", {"ref": ref}
            if "ok" == closer.apply(card, _decision(disposition, draft, **extra)):
                break
    return 0


def _pause_if_popup(popup):
    if popup:
        _line("\nenter closes the popup ")


def _held(row):
    return row.get("focused") or row.get("status") in ("working", "blocked")


def _verdict_rank(card):
    ranks = [VERDICT_ORDER.index(m["row"]["verdict"]) for m in card["members"]
             if (m.get("row") or {}).get("verdict") in VERDICT_ORDER]
    return min(ranks) if ranks else len(VERDICT_ORDER)


def cmd_cull(args, rest):
    popup = bool(os.environ.get("HERDR_SORT_POPUP"))
    try:
        rows, index = ledger.assess()
        rows = _numbered_stale(rows)
        if not rows:
            print("no open tabs")
            return 0
        cards, linear, llm = _assess(rows, index, [])
        everything = [c for c in cards if "open" == c["kind"]]
        held = [c for c in everything if all(_held(m.get("row") or {}) for m in c["members"])]
        cards = sorted((c for c in everything if c not in held), key=_verdict_rank)
        if held:
            print(f"not shown: {len(held)} working or focused: "
                  + ", ".join(shorten(c["title"], 30) for c in held))
        closer = _Closer(rows, index, linear)
        auto = [c for c in cards if c.get("auto") in ("trivial", "done")]
        if auto:
            print(f"{len(auto)} need no decision:")
            for card in auto:
                why = card.get("trivial") or (card.get("note") or {}).get("outcome") or ""
                print(f"  {card['auto']:<8} {_card_line(card)} {shorten(why, 50)}")
            if _yes(f"close all {len(auto)} as shown? [y/N] "):
                for card in auto:
                    closer.apply(card, _decision(card["auto"]))
        walk = [c for c in cards if c["id"] not in closer.done_ids]
        left = _walk(walk, closer, llm, CULL_KEYS, others=everything, popup=popup) if walk else 0
        kept = len(walk) - left - sum(c["id"] in closer.done_ids for c in walk)
        print(f"\nclosed {closer.closed} tabs; kept {kept} cards"
              + (f"; {left} not reached" if left else ""))
        log(f"cull closed {closer.closed} tabs")
        return 0
    finally:
        _pause_if_popup(popup)


def cmd_loops(args, rest):
    index, _ = ledger.sync()
    try:
        live = {r["key"] for r in ledger.live_panes() if r["key"]}
    except (RuntimeError, OSError):
        live = set()
    # A reopened session is an open tab, not a loop; assess only sees that through rows.
    events = [e for e in ledger.closes() if e.get("key") not in live]
    cards, linear, llm = _assess([], index, events)
    loops = [c for c in cards if "loop" == c["kind"]]
    cleared = [c for c in loops if c.get("resolved_by")]
    if cleared:
        print(f"{len(cleared)} resolved by a later session:")
        for card in cleared:
            by = card["resolved_by"]
            print(f"  {_card_line(card)}")
            print(_wrap("by", f"{by.get('title') or by.get('key')} ({by.get('key')}): "
                              f"{by.get('why') or ''}", indent=13))
        if _yes(f"mark these {len(cleared)} resolved? [y/N] "):
            for card in cleared:
                by = card["resolved_by"]
                for m in card["members"]:
                    event = m.get("event") or {}
                    ledger.append_resolution(
                        m.get("key") or event.get("key"), event.get("closed_at"),
                        {"disposition": "done",
                         "note": f"resolved later by {by.get('title') or '?'} ({by.get('key')})",
                         "model_session": by.get("model_session")})
            loops = [c for c in loops if not c.get("resolved_by")]
            print(f"marked {len(cleared)} resolved")
    if not loops:
        print("no open loops")
        return 0
    print(f"\n{len(loops)} closed sessions whose next step is still open")
    closer = _Closer([], index, linear)
    left = _walk(loops, closer, llm, LOOP_KEYS)
    print(f"\nresolved {closer.resolved}; {len(loops) - len(closer.done_ids)} still open"
          + (f" ({left} not reached)" if left else ""))
    return 0


def _since(text):
    m = re.fullmatch(r"(\d+)([hdw]?)", text or "7d")
    if not m:
        raise SystemExit("herdr-sort: --since wants an age like 24h, 7d or 2w")
    return int(m.group(1)) * {"h": 3600, "d": 86400, "w": 7 * 86400, "": 86400}[m.group(2)]


def cmd_review(args, rest):
    start = time.time() - _since(args.get("since"))
    events = [e for e in ledger.closes() if (e.get("closed_at") or 0) >= start]
    if not events:
        print(f"nothing closed since {_day(start)}")
        return 0
    groups = {}
    for event in events:
        groups.setdefault(event.get("disposition") or "", []).append(event)
    known = CLOSE_AS + ("kept",)
    order = ([d for d in known if d in groups] + sorted(d for d in groups if d and d not in known)
             + ([""] if "" in groups else []))
    print(f"{len(events)} closes since {_day(start)}: "
          + " · ".join(f"{len(groups[d])} {d or 'no disposition'}" for d in order))
    for disposition in order:
        print(f"\n{disposition or 'no disposition'}")
        for event in sorted(groups[disposition], key=lambda e: e.get("closed_at") or 0):
            print(f"  {_day(event.get('closed_at'))}  "
                  f"{shorten(event.get('title') or '(untitled)', 56):<56} "
                  f"{shorten(event.get('workspace') or '', 18)}")
            parts = [event.get("ref"), event.get("ref_url"),
                     event.get("note") and shorten(event["note"], 90)]
            if any(parts):
                print("         " + " · ".join(p for p in parts if p))
    return 0


def cmd_popup(args, rest):
    ledger.call("plugin.pane.open", {
        "plugin_id": "herdr-sort",
        "entrypoint": "cull",
        "placement": "popup",
        "width": "90%",
        "height": "90%",
        "focus": True,
        "env": {"HERDR_SORT_POPUP": "1"},
    })
    return 0


LEDGER_COMMANDS = {"stale": cmd_stale, "close": cmd_close, "log": cmd_log,
                   "reopen": cmd_reopen, "ledger": cmd_ledger, "cull": cmd_cull,
                   "loops": cmd_loops, "review": cmd_review, "popup": cmd_popup}


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except HerdrError as err:
        sys.exit(f"herdr-sort: {err}")
    except KeyboardInterrupt:
        sys.exit(130)
